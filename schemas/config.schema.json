{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home AI configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "default": "shadow",
      "enum": [
        "shadow"
      ]
    },
    "max_events": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 100000
    },
    "max_context_chars": {
      "type": "integer",
      "default": 16000,
      "minimum": 1024,
      "maximum": 1048576
    },
    "max_age_seconds": {
      "type": "integer",
      "default": 3600,
      "minimum": 1,
      "maximum": 604800
    },
    "cooldown_seconds": {
      "type": "integer",
      "default": 300,
      "minimum": 1,
      "maximum": 86400
    },
    "provider": {
      "type": "string",
      "default": "fixture",
      "enum": [
        "fixture",
        "ollama"
      ]
    },
    "model": {
      "type": "string",
      "default": "",
      "maxLength": 160
    },
    "model_url": {
      "type": "string",
      "default": "http://localhost:11434"
    },
    "allow_remote_model": {
      "type": "boolean",
      "default": false
    },
    "ha_url": {
      "type": "string",
      "default": ""
    },
    "entity_mapping": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "queue_capacity": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 10000
    },
    "max_queue_age_seconds": {
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "maximum": 3600
    },
    "allow_remote_ha": {
      "type": "boolean",
      "default": false
    }
  }
}
